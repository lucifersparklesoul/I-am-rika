# Environment example for I-am-rika Telegram bot
# Copy to .env and fill the required keys

# Telegram bot token (required)
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (required for chat)
GEMINI_API_KEY=

# Optional customizations
BOT_NAME=Yuki
OWNER_ID=
SUDO_USER_IDS=
DEVELOPER_USER_IDS=

# Voice settings (edge-tts voice name; keep defaults if unsure)
TTS_VOICE=en-US-AnaNeural
TTS_RATE=+0%
TTS_PITCH=+15%

# Hosting / webhook
PORT=8080
WEBHOOK_URL=
ENABLE_KEEPALIVE=true
